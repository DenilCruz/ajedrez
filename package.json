{
  "name": "chess-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Monorepo de plataforma de ajedrez (NestJS + React + React Native + Shared Domain)",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build:shared": "pnpm --filter @chess-platform/shared-domain build",
    "build": "pnpm --filter @chess-platform/shared-domain build && pnpm --filter web build",
    "test": "pnpm --filter @chess-platform/shared-domain test"
  }
}
